{
  "name": "@eduquiz/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configurations partagées (TypeScript, ESLint, Prettier, Tailwind, Vitest) pour le monorepo EduQuiz.",
  "type": "module",
  "exports": {
    "./tsconfig-library": "./tsconfig-library.json",
    "./tsconfig-react": "./tsconfig-react.json",
    "./tsconfig-nextjs": "./tsconfig-nextjs.json",
    "./tsconfig-expo": "./tsconfig-expo.json",
    "./tsconfig-node": "./tsconfig-node.json",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./tailwind": "./tailwind-config-base.js",
    "./vitest": "./vitest.config.base.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"[@eduquiz/config] test — rien à tester, paquet de config\" && exit 0",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.70.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0"
  },
  "peerDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
